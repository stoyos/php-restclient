{
    "name": "madelan/php-restclient",
    "description": "Cliente REST de Madelan: fork de tcdent/php-restclient con TLS prendido, armado de URL para GX y PHP 8.3",
    "type": "library",
    "keywords": ["REST", "api", "client", "curl", "JSON", "XML"],
    "homepage": "https://github.com/stoyos/php-restclient",
    "license": "MIT",
    "authors": [
        {
            "name": "Travis Dent",
            "role": "Developer",
            "email": "tcdent@gmail.com"
        },
        {
            "name": "Sebastian Toyos",
            "role": "Fork de Madelan"
        }
    ],
    "support": {
        "issues": "https://github.com/stoyos/php-restclient/issues"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "php": ">=8.3",
        "phpunit/phpunit": ">=9.6"
    },
    "autoload": {
        "files": ["restclient.php"]
    }
}
